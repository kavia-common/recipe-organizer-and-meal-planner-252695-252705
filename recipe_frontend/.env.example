# React App Environment Variables

# TheMealDB base URL (no API key required)
# Defaults to https://www.themealdb.com/api/json/v1/1 if not provided.
REACT_APP_MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# CORS proxy to allow browser requests to TheMealDB.
# Default proxy is https://corsproxy.io/? when variable is undefined.
# To disable proxy (e.g., when your environment injects CORS headers), set to an empty string:
# REACT_APP_CORS_PROXY=
# To override with a different proxy, set to that URL (should include trailing '?' or it will be added):
# REACT_APP_CORS_PROXY=https://your-proxy.example.com/?
# Leave unset to use the default.
# REACT_APP_CORS_PROXY=
