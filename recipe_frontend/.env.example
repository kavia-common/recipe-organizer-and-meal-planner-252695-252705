# Frontend environment variables for Spoonacular direct integration
# WARNING: Client-side API keys are exposed to end users. Apply domain restrictions
# and monitor usage in your Spoonacular account. Consider a backend proxy for production.

# Required: your Spoonacular API key
REACT_APP_SPOONACULAR_API_KEY=your-spoonacular-api-key-here

# Optional: base URL for Spoonacular API (defaults to https://api.spoonacular.com)
REACT_APP_SPOONACULAR_BASE_URL=https://api.spoonacular.com
